# ============================================================
# ReparaYa — company-service variables de entorno
# Copia este archivo a .env y completa los valores reales
# NUNCA subas .env a Git
# ============================================================

# ── PostgreSQL (Neon) ─────────────────────────────────────────
DB_URL=jdbc:postgresql://ep-xxxx.us-east-1.aws.neon.tech/reparaya?currentSchema=company&sslmode=require
DB_USER=tu_usuario_neon
DB_PASSWORD=tu_password_neon

# ── Keycloak ──────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=reparaya

# ── Maven settings.xml (para build con Docker) ───────────────
MAVEN_SETTINGS_PATH=~/.m2/settings.xml
